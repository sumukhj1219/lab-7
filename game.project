[project]
title = Lab 7: Chain Reaction
dependencies#0 = https://github.com/wvdsh/sdk-defold/archive/refs/tags/1.2.0.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
high_dpi = 0

[render]
clear_color_red = 0.08
clear_color_green = 0.09
clear_color_blue = 0.11
clear_color_alpha = 1

[physics]
type = 2D
debug = 0
max_collision_object_count = 256
max_collisions = 256
max_contacts = 512

[script]
shared_state = 1

[html5]
scale_mode = fit
