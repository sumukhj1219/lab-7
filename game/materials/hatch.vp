#version 140

// Sprite vertex shader that also passes the world position on, so the
// fragment shader can draw stripes at a fixed size in room pixels.

in highp vec4 position;
in mediump vec2 texcoord0;

out mediump vec2 var_texcoord0;
out highp vec2 var_world;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

void main()
{
    gl_Position = view_proj * vec4(position.xyz, 1.0);
    var_texcoord0 = texcoord0;
    var_world = position.xy;
}
