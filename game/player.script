-- The scientist (§5.1, §5.8).
-- States: normal -> infected -> drinking -> (cured) normal, or -> turned.
-- Health drops on every zombie hit and drains while infected; an antidote
-- cures and heals ANTIDOTE_HEAL. At 0 health the player turns.
-- The manager owns the antidote count; this script owns health.

local config = require "modules.config"
local world = require "modules.world"
local sfx = require "modules.sfx"

local UP = hash("up")
local DOWN = hash("down")
local LEFT = hash("left")
local RIGHT = hash("right")
local RELEASE = hash("release")
local TOWER = hash("tower")
local GAS = hash("gas")
local DRINK = hash("drink")
local WALL = hash("wall")
local CAGE = hash("cage")
local TERMINAL = hash("terminal")

local MANAGER = "/manager#script"
local HEALTH_FILL = "/player_health"

local function play(self, anim)
	if self.anim ~= anim then
		self.anim = anim
		sprite.play_flipbook("#sprite", anim)
	end
end

-- The sheet has front, back and side views; side frames face left as drawn.
local function update_animation(self, dir, moving)
	if self.state == "drinking" then
		self.facing = "front" -- face the camera while drinking
	elseif moving then
		if dir.x ~= 0 then
			self.facing = "side"
			self.face_right = dir.x > 0
		else
			self.facing = dir.y > 0 and "back" or "front"
		end
	end
	if self.facing == "side" then
		play(self, moving and "player_walk_side" or "player_idle_side")
		sprite.set_hflip("#sprite", self.face_right)
	else
		play(self, "player_idle_" .. self.facing)
		sprite.set_hflip("#sprite", false)
	end
end

local STATE_PLACEHOLDER_TINT = {
	normal = config.TINT.player,
	infected = config.TINT.player_infected,
	drinking = config.TINT.player_drinking,
	turned = config.TINT.player_turned,
}

-- Shows the current state as a color wash (the sheet has no state frames).
local function refresh_tint(self)
	local tint = config.placeholder("player") and STATE_PLACEHOLDER_TINT[self.state] or config.PLAYER_STATE_TINT[self.state]
	local alpha = go.get("#sprite", "tint.w") -- keep the invulnerability blink
	go.set("#sprite", "tint", vmath.vector4(tint.x, tint.y, tint.z, alpha))
end

-- Mouse position in room coordinates. The render script letterboxes the
-- 1280x720 room inside the window (fixed fit), so undo that zoom and offset.
local function screen_to_room(screen_x, screen_y)
	local w, h = window.get_size()
	local zoom = math.min(w / config.ROOM_WIDTH, h / config.ROOM_HEIGHT)
	local x = (screen_x - (w - config.ROOM_WIDTH * zoom) / 2) / zoom
	local y = (screen_y - (h - config.ROOM_HEIGHT * zoom) / 2) / zoom
	return vmath.vector3(x, y, 0)
end

-- Blinking protection for `time` seconds (nil = switch it off).
local function set_invulnerable(self, time)
	if self.invuln_timer then
		timer.cancel(self.invuln_timer)
		self.invuln_timer = nil
	end
	self.invulnerable = time ~= nil
	go.cancel_animations("#sprite", "tint.w")
	go.set("#sprite", "tint.w", 1)
	if time then
		go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.2, go.EASING_LINEAR, config.BLINK_PERIOD)
		self.invuln_timer = timer.delay(time, false, function() set_invulnerable(self, nil) end)
	end
end

-- Bar above the head: shrinks from the right, green -> yellow -> red.
local function update_health_bar(self)
	local f = math.max(0, self.health / config.PLAYER_HEALTH)
	go.set_scale(vmath.vector3(math.max(f, 0.001), 1, 1), HEALTH_FILL)
	go.set_position(vmath.vector3(-config.HEALTH_BAR_W / 2 * (1 - f), config.HEALTH_BAR_Y, 0.06), HEALTH_FILL)
	local C = config.UI_COLOR
	go.set(HEALTH_FILL .. "#fill", "tint", f > 0.6 and C.health_high or (f > 0.3 and C.health_mid or C.health_low))
	-- Pin the stripes to the player so they don't slide through the bar.
	local pos = go.get_position()
	go.set(HEALTH_FILL .. "#fill", "origin", vmath.vector4(pos.x, pos.y, 0, 0))
end

local function finish_drinking(self)
	self.drink_timer = nil
	msg.post(MANAGER, "drink_finished", { health = self.health })
	self.health = math.min(config.PLAYER_HEALTH, self.health + config.ANTIDOTE_HEAL)
	self.state = "normal"
	refresh_tint(self)
	set_invulnerable(self, config.CURE_INVULN)
end

local function turn(self)
	if self.drink_timer then
		timer.cancel(self.drink_timer) -- too late, the drink never finishes
		self.drink_timer = nil
	end
	self.state = "turned"
	refresh_tint(self)
	timer.delay(config.TURN_TIME, false, function()
		msg.post(MANAGER, "player_turned")
	end)
end

local function lose_health(self, amount)
	self.health = self.health - amount
	if self.health <= 0 then
		self.health = 0
		turn(self)
	end
end

-- A zombie hit: damage, infection (if not already), a moment of protection.
local function take_hit(self)
	sfx.play("hit")
	if self.state == "drinking" then
		-- Hit mid-drink: cancelled, but the antidote is kept.
		timer.cancel(self.drink_timer)
		self.drink_timer = nil
		self.state = "infected"
		msg.post(MANAGER, "drink_interrupted")
	elseif self.state == "normal" then
		self.state = "infected"
		msg.post(MANAGER, "player_infected")
	end
	refresh_tint(self)
	lose_health(self, config.HIT_DAMAGE)
	if self.state ~= "turned" then
		set_invulnerable(self, config.HIT_INVULN)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.keys = {}
	self.correction = vmath.vector3()
	self.mouse = vmath.vector3(config.ROOM_WIDTH / 2, config.ROOM_HEIGHT / 2, 0)
	self.state = "normal"
	self.invulnerable = false
	self.health = config.PLAYER_HEALTH
	self.facing = "front"
	self.face_right = false
	refresh_tint(self)
end

function update(self, dt)
	if self.state == "infected" or self.state == "drinking" then
		lose_health(self, config.INFECTION_DRAIN * dt)
	end

	local dir = vmath.vector3()
	if self.state == "normal" or self.state == "infected" then
		if self.keys[UP] then dir.y = dir.y + 1 end
		if self.keys[DOWN] then dir.y = dir.y - 1 end
		if self.keys[LEFT] then dir.x = dir.x - 1 end
		if self.keys[RIGHT] then dir.x = dir.x + 1 end
	end

	local moving = vmath.length_sqr(dir) > 0
	if moving then
		dir = vmath.normalize(dir)
		go.set_position(go.get_position() + dir * config.PLAYER_SPEED * dt)
	end
	update_animation(self, dir, moving)
	update_health_bar(self) -- after moving, so the bar's stripes stay in step

	world.player_pos = go.get_position()
	world.player_state = self.state
	world.player_health = self.health
	self.correction = vmath.vector3()
end

-- Push the player out of walls, cages and terminals without jitter when touching several at once.
local function separate(self, normal, distance)
	if distance <= 0 then return end
	local proj = vmath.project(self.correction, normal * distance)
	if proj < 1 then
		local comp = (distance - distance * proj) * normal
		go.set_position(go.get_position() + comp)
		self.correction = self.correction + comp
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		if message.other_group == WALL or message.other_group == CAGE or message.other_group == TERMINAL then
			separate(self, message.normal, message.distance)
		end
	elseif message_id == hash("infect") then
		if not self.invulnerable and self.state ~= "turned" then
			take_hit(self)
		end
	elseif message_id == hash("start_drink") then
		if self.state == "infected" then
			self.state = "drinking"
			refresh_tint(self)
			self.drink_timer = timer.delay(config.DRINK_TIME, false, finish_drinking)
		end
	end
end

function on_input(self, action_id, action)
	if action_id == nil then
		if action.screen_x then
			self.mouse = screen_to_room(action.screen_x, action.screen_y)
		end
		return
	end
	if action.released then
		self.keys[action_id] = false -- always let go of keys, even while paused
	end
	if self.state == "turned" or world.paused then
		return
	end

	if action_id == RELEASE then
		if action.pressed then
			msg.post(MANAGER, "release_request")
		end
	elseif action_id == TOWER then
		if action.pressed then
			msg.post(MANAGER, "tower_request")
		end
	elseif action_id == GAS then
		if action.pressed then
			msg.post(MANAGER, "gas_request", { target = self.mouse })
		end
	elseif action_id == DRINK then
		if action.pressed then
			if self.state == "infected" then
				msg.post(MANAGER, "drink_request")
			elseif self.state == "normal" then
				msg.post(MANAGER, "antidote_not_needed")
			end
		end
	else
		self.keys[action_id] = not action.released
	end
end
