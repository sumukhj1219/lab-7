-- Game Over screen (§7): score breakdown, session best, retry, menu.
-- On Wavedash it also shows the player's rank and the top 10.

local config = require "modules.config"
local score = require "modules.score"
local dialog = require "modules.dialog_data"
local ui = require "modules.ui"
local wd = require "modules.wd"

local W, H = config.ROOM_WIDTH, config.ROOM_HEIGHT
local MAIN = "main:/main#script"

local CLICK = hash("click")
local RETRY = hash("retry")

function init(self)
	gui.set_render_order(6)
	msg.post(".", "acquire_input_focus")

	self.root = ui.box(nil, W / 2, H / 2, W, H, config.UI_COLOR.panel)
	ui.text(self.root, 0, 290, "GAME OVER", 1.6, config.UI_COLOR.bad)
	self.line = ui.text(self.root, 0, 235, "", 0.6, config.UI_COLOR.dim)
	self.score = ui.text(self.root, 0, 180, "", 1.2, config.UI_COLOR.score)
	self.best = ui.text(self.root, 0, 135, "", 0.65, config.UI_COLOR.text)
	self.labels = ui.text(self.root, -260, 0, "", 0.6, config.UI_COLOR.dim, gui.PIVOT_W)
	self.values = ui.text(self.root, 260, 0, "", 0.6, config.UI_COLOR.text, gui.PIVOT_E)
	self.stats = ui.text(self.root, 0, -150, "", 0.55, config.UI_COLOR.dim)
	self.rank = ui.text(self.root, 0, 100, "", 0.6, config.UI_COLOR.chain)
	self.top_title = ui.text(self.root, 470, 250, "TOP 10", 0.6, config.UI_COLOR.chain)
	self.top = ui.columns(self.root, 330, 610, 215, 0.5, config.UI_COLOR.text, config.UI_COLOR.score)
	gui.set_enabled(self.top_title, false)
	self.buttons = {
		retry = ui.button(self.root, -140, -250, 240, 50, "Retry (R)"),
		menu = ui.button(self.root, 140, -250, 240, 50, "Menu"),
	}
	gui.set_enabled(self.root, false)
	self.shown = false
end

local function show(self, run, best, new_best)
	self.shown = true
	gui.set_enabled(self.root, true)
	gui.set_text(self.line, dialog.game_over[math.random(#dialog.game_over)])
	gui.set_text(self.score, tostring(run.score))
	gui.set_text(self.best, new_best and "NEW SESSION BEST!" or ("Session best: " .. best))

	local labels, values = {}, {}
	for _, c in ipairs(score.CATEGORIES) do
		labels[#labels + 1] = c.label
		values[#values + 1] = tostring(run.breakdown[c.id])
	end
	gui.set_text(self.labels, table.concat(labels, "\n"))
	gui.set_text(self.values, table.concat(values, "\n"))
	if wd.is_available() then
		gui.set_text(self.rank, "Submitting score...")
		gui.set_enabled(self.top_title, true)
	end
	gui.set_text(self.stats, string.format(
		"%d s survived   %d stuns   best chain %d   %d antidotes used",
		math.floor(run.seconds), run.stuns, run.best_chain, run.antidotes_used))
end

local function show_top(self, entries)
	local rows = ui.leaderboard_rows(entries)
	if #rows == 0 then rows = { { "No scores yet", "" } } end
	ui.set_columns(self.top, rows)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		show(self, message.run, message.best, message.new_best)
	elseif message_id == hash("rank") then
		gui.set_text(self.rank, message.rank and ("Leaderboard rank #" .. message.rank) or "Could not submit score")
	elseif message_id == hash("top") then
		show_top(self, message.entries)
	end
end

function on_input(self, action_id, action)
	if not self.shown then return false end
	ui.hover(self.buttons, action)
	if action_id == RETRY and action.pressed then
		msg.post(MAIN, "restart_game")
	elseif action_id == CLICK and action.pressed then
		if ui.hit(self.buttons.retry, action) then
			msg.post(MAIN, "restart_game")
		elseif ui.hit(self.buttons.menu, action) then
			msg.post(MAIN, "show_menu")
		end
	end
	return true
end
